{
  "name": "dear-diary",
  "version": "1.0.0",
  "private": true,
  "description": "A private, account-based online diary",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node -e \"const fs=require('node:fs');const vm=require('node:vm');const html=fs.readFileSync('public/index.html','utf8');new vm.Script(html.split('<script>')[1].split('</script>')[0]);\""
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  }
}
